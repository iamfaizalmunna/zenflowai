// ZenFlowAI — Prisma Schema
// MySQL · Phase 1: Foundation & Auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum Role {
  CUSTOMER
  AGENT
  SUPERVISOR
  ADMIN
  SUPER_ADMIN
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  BUG
  FEATURE
  QUESTION
  INCIDENT
  TASK
}

enum MessageType {
  REPLY          // visible to customer + agent
  INTERNAL_NOTE  // agent/supervisor only
  SYSTEM_EVENT   // auto-generated (e.g. "Status changed to Resolved")
}

enum RoutingRuleType {
  CATEGORY
  KEYWORD
  PRIORITY
  FALLBACK
}

enum AuditCategory {
  AUTH
  ACCESS
  TICKET
  MODERATION
  SECURITY
  ADMIN
  FAIR_USAGE
}

enum AuditSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum SpamStatus {
  PENDING
  CONFIRMED
  DISMISSED
  AUTO_BLOCKED
}

enum SpamReason {
  SPAM_CONTENT
  SCAM
  BOT_BEHAVIOR
  ABUSE
  DUPLICATE
  FAKE_ACCOUNT
  OTHER
}

enum ArticleVisibility {
  PUBLIC    // customers + agents
  INTERNAL  // agents + supervisors only
}

enum CsatStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_REPLIED
  TICKET_RESOLVED
  TICKET_CLOSED
  SLA_WARNING
  SLA_BREACHED
  CSAT_REQUEST
  SYSTEM
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// ═══════════════════════════════════════════════════════════════
// USERS & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String // bcrypt hash

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)
  isBanned Boolean @default(false)
  banReason String?
  bannedAt  DateTime?

  // Login security
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Email verification
  emailVerified     Boolean @default(false)
  emailVerifyToken  String? @unique

  // Password reset
  passwordResetToken   String?  @unique
  passwordResetExpires DateTime?

  // 2FA (optional, future)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Suspicion (spam/abuse scoring)
  isSuspicious    Boolean @default(false)
  suspicionScore  Float   @default(0) // 0–100
  suspicionReason String?

  // Activity metadata
  lastLoginAt  DateTime?
  lastLoginIp  String?
  registeredIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions       UserSession[]
  refreshTokens  RefreshToken[]
  teamMembers    TeamMember[]
  createdTickets Ticket[]          @relation("TicketCreatedBy")
  assignedTickets Ticket[]         @relation("TicketAssignedTo")
  messages       TicketMessage[]
  notifications  Notification[]
  auditLogs      AuditLog[]        @relation("AuditActor")
  csatSurveys    CsatSurvey[]
  savedQueries   SavedQuery[]
  bookmarks      BookmarkedNode[]
  permissionOverrides PermissionOverride[]

  @@index([email])
  @@index([role])
  @@index([isBanned])
  @@index([isSuspicious])
  @@map("users")
}

model UserSession {
  id          String   @id @default(uuid())
  userId      Int
  tokenHash   String   @unique // SHA-256 of access token
  ip          String
  userAgent   String?  @db.Text
  isRevoked   Boolean  @default(false)
  revokedAt   DateTime?
  revokedReason String?
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String   @unique // SHA-256 of the refresh token (never store raw)
  ip        String?
  userAgent String?  @db.Text
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════
// TEAMS
// ═══════════════════════════════════════════════════════════════

model Team {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isDefault   Boolean @default(false) // fallback team for unmatched routing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       TeamMember[]
  tickets       Ticket[]
  routingRules  RoutingRule[]
  routingDecisions RoutingDecision[]

  @@map("teams")
}

model TeamMember {
  teamId Int
  userId Int
  isLead Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

// ═══════════════════════════════════════════════════════════════
// CATEGORIES & ROUTING
// ═══════════════════════════════════════════════════════════════

model Category {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  description     String?
  color           String         @default("#6366f1")
  defaultPriority TicketPriority @default(MEDIUM)
  defaultTeamId   Int?

  tickets      Ticket[]
  routingRules RoutingRule[]
  articles     KnowledgeArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model RoutingRule {
  id               Int              @id @default(autoincrement())
  type             RoutingRuleType
  categoryId       Int?
  keyword          String?
  priority         TicketPriority?
  targetTeamId     Int
  priorityOverride TicketPriority?
  order            Int              @default(100)
  isActive         Boolean          @default(true)

  targetTeam Team      @relation(fields: [targetTeamId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("routing_rules")
}

// ═══════════════════════════════════════════════════════════════
// SLA POLICIES
// ═══════════════════════════════════════════════════════════════

model SlaPolicy {
  id                  Int            @id @default(autoincrement())
  priority            TicketPriority @unique
  responseTimeHours   Float          // time to first reply
  resolutionTimeHours Float          // time to full resolution
  isActive            Boolean        @default(true)

  @@map("sla_policies")
}

// ═══════════════════════════════════════════════════════════════
// TICKETS
// ═══════════════════════════════════════════════════════════════

model Ticket {
  id           Int            @id @default(autoincrement())
  ticketNumber String         @unique // #ZEN-0001
  title        String
  description  String         @db.Text
  status       TicketStatus   @default(NEW)
  priority     TicketPriority @default(MEDIUM)
  type         TicketType     @default(QUESTION)

  // People
  customerId   Int
  teamId       Int?
  assignedToId Int?
  categoryId   Int?

  // SLA tracking
  slaResponseDueAt      DateTime?
  slaResolutionDueAt    DateTime?
  firstRespondedAt      DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  slaResponseBreached   Boolean @default(false)
  slaResolutionBreached Boolean @default(false)

  // Spam / AI
  isSpamFlagged          Boolean @default(false)
  aiClassificationScore  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customer   User      @relation("TicketCreatedBy", fields: [customerId], references: [id])
  team       Team?     @relation(fields: [teamId], references: [id])
  assignedTo User?     @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])

  messages         TicketMessage[]
  attachments      Attachment[]
  tags             TicketTag[]
  csatSurvey       CsatSurvey?
  routingDecision  RoutingDecision?

  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([assignedToId])
  @@index([teamId])
  @@index([slaResolutionDueAt])
  @@map("tickets")
}

model Tag {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  color     String      @default("#94a3b8")
  createdAt DateTime    @default(now())
  tickets   TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId Int
  tagId    Int

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}

// ═══════════════════════════════════════════════════════════════
// MESSAGES & ATTACHMENTS
// ═══════════════════════════════════════════════════════════════

model TicketMessage {
  id       Int         @id @default(autoincrement())
  ticketId Int
  senderId Int
  body     String      @db.Text
  type     MessageType @default(REPLY)
  isRead   Boolean     @default(false) // for customer read receipts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User         @relation(fields: [senderId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model Attachment {
  id          Int    @id @default(autoincrement())
  ticketId    Int
  messageId   Int?
  filename    String
  storagePath String // local path or cloud URL
  mimeType    String
  sizeBytes   Int
  uploadedById Int

  createdAt DateTime @default(now())

  ticket  Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("attachments")
}

// ═══════════════════════════════════════════════════════════════
// ROUTING DECISIONS (audit trail)
// ═══════════════════════════════════════════════════════════════

model RoutingDecision {
  id             Int  @id @default(autoincrement())
  ticketId       Int  @unique
  ruleId         Int? // which rule matched (null = fallback)
  assignedTeamId Int
  assignedUserId Int? // null = unassigned, goes to team queue
  reason         String

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [assignedTeamId], references: [id])

  @@map("routing_decisions")
}

// ═══════════════════════════════════════════════════════════════
// KNOWLEDGE BASE
// ═══════════════════════════════════════════════════════════════

model KnowledgeArticle {
  id          Int                @id @default(autoincrement())
  title       String
  body        String             @db.LongText // markdown
  visibility  ArticleVisibility  @default(PUBLIC)
  categoryId  Int?
  authorId    Int
  viewCount   Int                @default(0)
  isPublished Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([visibility, isPublished])
  @@map("knowledge_articles")
}

// ═══════════════════════════════════════════════════════════════
// CSAT
// ═══════════════════════════════════════════════════════════════

model CsatSurvey {
  id         Int        @id @default(autoincrement())
  ticketId   Int        @unique
  customerId Int
  rating     Int?       // 1–5, null until submitted
  comment    String?    @db.Text
  status     CsatStatus @default(PENDING)
  sentAt     DateTime   @default(now())
  submittedAt DateTime?
  expiresAt  DateTime   // sentAt + 7 days

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@map("csat_surveys")
}

// ═══════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════

model Notification {
  id       Int              @id @default(autoincrement())
  userId   Int
  type     NotificationType
  ticketId Int?
  title    String
  body     String
  isRead   Boolean          @default(false)
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════
// WEBHOOKS
// ═══════════════════════════════════════════════════════════════

model Webhook {
  id       Int     @id @default(autoincrement())
  url      String
  secret   String  // HMAC signing key
  events   Json    // string[]
  isActive Boolean @default(true)

  createdAt   DateTime          @default(now())
  deliveries  WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id         Int                   @id @default(autoincrement())
  webhookId  Int
  event      String
  payload    Json
  status     WebhookDeliveryStatus @default(PENDING)
  httpStatus Int?
  attempts   Int                   @default(0)
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  createdAt     DateTime            @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@map("webhook_deliveries")
}

// ═══════════════════════════════════════════════════════════════
// SECURITY LAYER
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id         Int           @id @default(autoincrement())
  action     String        // e.g. "LOGIN_SUCCESS", "TICKET_CREATED"
  category   AuditCategory
  severity   AuditSeverity @default(INFO)
  actorId    Int?
  actorIp    String?
  actorAgent String?       @db.Text
  targetType String?       // "User", "Ticket", etc.
  targetId   Int?
  message    String        @db.Text
  metadata   Json?
  createdAt  DateTime      @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([severity])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model BlockedIp {
  id          Int       @id @default(autoincrement())
  ip          String    @unique
  reason      String
  blockedById Int?
  expiresAt   DateTime? // null = permanent
  createdAt   DateTime  @default(now())

  @@index([ip])
  @@map("blocked_ips")
}

model RateLimitViolation {
  id            Int      @id @default(autoincrement())
  ip            String
  userId        Int?
  endpoint      String
  violationType String
  requestCount  Int      @default(1)
  windowStart   DateTime
  createdAt     DateTime @default(now())

  @@index([ip])
  @@index([userId])
  @@index([createdAt])
  @@map("rate_limit_violations")
}

model CooldownPeriod {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  cooldownMs Int
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId, action])
  @@index([endsAt])
  @@map("cooldown_periods")
}

model UsageQuota {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  ticketsThisHour      Int      @default(0)
  ticketsToday         Int      @default(0)
  messagesThisHour     Int      @default(0)
  messagesToday        Int      @default(0)
  apiCallsThisMinute   Int      @default(0)
  apiCallsToday        Int      @default(0)
  hourWindowStart      DateTime @default(now())
  dayWindowStart       DateTime @default(now())
  minuteWindowStart    DateTime @default(now())
  quotaViolations      Int      @default(0)
  lastViolationAt      DateTime?
  updatedAt            DateTime @updatedAt

  @@map("usage_quotas")
}

model SpamReport {
  id           Int        @id @default(autoincrement())
  targetType   String     // "Ticket", "TicketMessage"
  targetId     Int
  reportedById Int?
  reason       SpamReason
  aiScore      Float      @default(0) // 0–1
  aiFlags      Json?
  status       SpamStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime   @default(now())

  @@index([targetType, targetId])
  @@index([status])
  @@map("spam_reports")
}

model PermissionOverride {
  id          Int       @id @default(autoincrement())
  userId      Int
  permission  String    // e.g. "ticket:delete"
  granted     Boolean   // true = grant, false = revoke
  grantedById Int?
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("permission_overrides")
}

// ═══════════════════════════════════════════════════════════════
// GRAPHQL SUPERPOWERS (persisted queries + node bookmarks)
// ═══════════════════════════════════════════════════════════════

model SavedQuery {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  query        String   @db.Text
  hash         String   @unique // SHA-256 APQ hash
  variables    Json?
  isBookmarked Boolean  @default(false)
  tags         String?  // comma-separated

  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hash])
  @@map("saved_queries")
}

model BookmarkedNode {
  id       Int    @id @default(autoincrement())
  userId   Int
  nodeType String // "Ticket", "User", etc. — polymorphic, no FK
  nodeId   Int
  label    String?
  color    String @default("#6366f1")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeType, nodeId])
  @@index([userId])
  @@map("bookmarked_nodes")
}
