{
  "name": "zenflowai-ticketing",
  "version": "1.0.0",
  "private": true,
  "description": "ZenFlowAI - Full-Stack Ticketing System (Next.js + Express + GraphQL + MySQL)",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm run --parallel build",
    "lint": "pnpm run --parallel lint",
    "test": "pnpm --filter backend test",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:generate": "pnpm --filter backend db:generate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
